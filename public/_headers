# Cloudflare Pages/Workers reads this file to set response headers on static
# assets. Vite's hashed build output (/assets/*) is safe to cache forever,
# since a content change produces a new filename. Hand-authored files under
# /images/ keep their names when swapped, so they get a shorter cache that
# still avoids re-fetching on every navigation within the session.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400
