# Google Places API (New) — server-side reviews.
#
# 1. console.cloud.google.com: create a project, enable "Places API (New)"
# 2. Create an API key and restrict it to that one API
# 3. Set a daily quota cap so a runaway loop cannot spend money
GOOGLE_MAPS_API_KEY=

# The clinic's Google place ID, from its Maps listing.
GOOGLE_PLACE_ID=
